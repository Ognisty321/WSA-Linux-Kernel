# SPDX-License-Identifier: GPL-2.0
#
# Experimental WSA x86_64 IBT/CFI validation fragment.
#
# The 5.15.104 WSA x86_64 base may not expose every symbol below. Keep this
# as a merge_config/olddefconfig probe for debug or QEMU-style validation, not
# as a production WSA config. Unsupported options should be dropped by
# olddefconfig and recorded in the validation notes.

CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_CLANG_SHADOW=y
CONFIG_CFI_PERMISSIVE=y

# Present in newer x86 kernels; kept here as an explicit probe target.
CONFIG_X86_KERNEL_IBT=y
CONFIG_FINEIBT=y
