#
# Optional WSA x86_64 sanitizer validation fragment. This is intended for
# short boot/load/control/unload repro runs, not for a daily WSA kernel.

CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_VMALLOC=y
CONFIG_KASAN_STACK=y
CONFIG_KCSAN=y
CONFIG_KCSAN_VERBOSE=y
CONFIG_KCSAN_REPORT_RACE_UNKNOWN_ORIGIN=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_LOCAL_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
CONFIG_UBSAN_BOOL=y
CONFIG_UBSAN_ENUM=y
