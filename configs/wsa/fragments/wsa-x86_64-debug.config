# SPDX-License-Identifier: GPL-2.0
#
# Optional WSA x86_64 debug validation fragment for the ReSukiSU/SUSFS/KPM
# kernel. Apply on top of configs/wsa/config-wsa-x64 with
# scripts/kconfig/merge_config.sh before olddefconfig.
#
# This fragment favors lock, list, memory lifetime and W^X diagnostics over
# boot speed. Some options may be silently dropped by olddefconfig when the
# base kernel/toolchain does not support them.

CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_FRAME_POINTER=y
CONFIG_STACKTRACE=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_WX=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=y

CONFIG_PROVE_LOCKING=y
CONFIG_LOCKDEP=y
CONFIG_LOCK_STAT=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_RCU=y
CONFIG_RCU_TRACE=y

CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255
